# Copy to .dev.vars (gitignored) and fill in values for local dev.
# Production uses `wrangler secret put <NAME>`.

# Auth (T-13). Secret: at least 32 random characters (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Optional: public origin (e.g. https://frenchy.example); unset, it is taken from the request.
BETTER_AUTH_URL=
# Optional: extra origins allowed to call /api/auth/*, comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS=
# Google sign-in turns on only when both are set (H-03).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (T-23): provider per task is one of anthropic | openai-compatible | mock
AI_TRANSLATE_PROVIDER=
AI_EXPLAIN_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
