{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frenchy",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "not_found_handling": "single-page-application",
    // The array form also skips the Sec-Fetch-Mode: navigate shortcut, so a browser
    // navigation to /api/* reaches the Worker instead of getting index.html.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frenchy",
      "database_id": "ac8e2710-6057-4c70-a6ef-ed26c5ed70f5",
    },
  ],
}
